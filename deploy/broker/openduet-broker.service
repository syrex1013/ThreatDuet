[Unit]
Description=OpenDuet private workspace broker
After=docker.service network-online.target
Wants=network-online.target
Requires=docker.service

[Service]
Type=simple
User=adrian
Group=adrian
WorkingDirectory=/opt/openduet
EnvironmentFile=/var/lib/openduet/secrets/broker.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin
ExecStart=/usr/local/bin/bun run broker
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
