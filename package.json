{
  "name": "threatduet",
  "productName": "ThreatDuet",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "description": "A proactive coworker in the style of Claude Duet, running on Kilo Code free auto model",
  "author": "ThreatVector",
  "main": "dist/electron/main.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n server,web \"tsx watch src/server/index.ts\" \"vite\"",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.mjs && tsc -p web/tsconfig.json && vite build",
    "start": "node dist/server/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "test": "vitest run",
    "app": "bun run build && electron .",
    "dist:desktop": "bun run build && electron-builder",
    "android:sync": "bun run build && cap sync android",
    "android:apk": "bun run android:sync && cd android && ./gradlew assembleDebug",
    "android:release": "bun run android:sync && cd android && ./gradlew assembleRelease",
    "release": "bash scripts/release.sh",
    "smoke:computer": "node scripts/smoke-computer.mjs",
    "smoke:daily-work": "bun run build && vitest run --config scripts/daily-work.vitest.ts",
    "smoke:task": "tsx scripts/smoke-task.mts",
    "emulate:windows": "tsx scripts/emulate-windows.mts",
    "dist:win": "bun run build && electron-builder --win --x64",
    "broker": "bun src/server/broker/index.ts",
    "broker:admin": "bun src/server/broker/admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@hono/zod-validator": "^0.9.1",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "croner": "^11.0.0",
    "execa": "^10.2.1",
    "fix-path": "^5.0.0",
    "hono": "^4.13.14",
    "lowdb": "^7.0.1",
    "node-notifier": "^12.0.0",
    "p-queue": "^10.0.0",
    "pdfjs-dist": "5.4.296",
    "pino": "^10.4.0",
    "playwright-core": "^1.64.1",
    "smol-toml": "^1.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/assets": "^4.0.0",
    "@capacitor/background-runner": "^3.0.0",
    "@capacitor/cli": "^8.6.0",
    "@capacitor/core": "^8.6.0",
    "@capacitor/preferences": "^8.0.1",
    "@fontsource-variable/saira": "^5.3.0",
    "@tanstack/react-query": "^5.105.0",
    "@types/node": "^26.6.6",
    "@types/node-notifier": "^8.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^44.10.1",
    "electron-builder": "^26.18.0",
    "lucide-react": "^1.66.0",
    "motion": "^14.9.0",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "build": {
    "appId": "tech.threatvector.threatduet",
    "productName": "ThreatDuet",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "web/dist/**/*",
      "build/icon.png",
      "build/trayTemplate*.png",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSDocumentsFolderUsageDescription": "Duet reads and searches files in the folders you allow in the Your Mac panel.",
        "NSDesktopFolderUsageDescription": "Duet reads and searches files in the folders you allow in the Your Mac panel.",
        "NSDownloadsFolderUsageDescription": "Duet reads and searches files in the folders you allow in the Your Mac panel.",
        "NSRemovableVolumesUsageDescription": "Duet reads and searches files on drives you allow in the Your Mac panel.",
        "NSNetworkVolumesUsageDescription": "Duet reads and searches files on drives you allow in the Your Mac panel.",
        "NSSystemAdministrationUsageDescription": "Duet reads files anywhere on this Mac only when you turn on Everything in the Your Mac panel."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "signAndEditExecutable": false
    },
    "linux": {
      "target": "AppImage",
      "category": "Office",
      "icon": "build/icon.png"
    },
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true,
      "enableEmbeddedAsarIntegrityValidation": true,
      "grantFileProtocolExtraPrivileges": false,
      "resetAdHocDarwinSignature": true
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "artifactName": "ThreatDuet-Setup-${version}.${ext}"
    }
  },
  "packageManager": "bun@1.3.14"
}
